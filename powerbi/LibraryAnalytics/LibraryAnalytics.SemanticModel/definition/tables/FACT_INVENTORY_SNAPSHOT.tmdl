table FACT_INVENTORY_SNAPSHOT
	lineageTag: 3e35687f-841c-5069-914b-0818b058bf30

	/// date_id of the latest monthly snapshot in the selected period.
	measure '_Last Snapshot Date' = CALCULATE ( MAX ( FACT_INVENTORY_SNAPSHOT[date_id] ), ALL ( FACT_INVENTORY_SNAPSHOT ), ALLSELECTED ( DIM_DATE ) )
		formatString: 0
		displayFolder: 00 - Common
		lineageTag: 1e82c46e-1893-550e-af21-a3da6136ce55

	measure 'Total Copies (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN CALCULATE ( SUM ( FACT_INVENTORY_SNAPSHOT[total_copies] ), FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d ) )
		formatString: #,0
		displayFolder: 06 - Stock
		lineageTag: 1be633a2-2468-52cb-9bbb-ec1b0664af1a

	measure 'Available Copies (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN CALCULATE ( SUM ( FACT_INVENTORY_SNAPSHOT[available_copies] ), FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d ) )
		formatString: #,0
		displayFolder: 06 - Stock
		lineageTag: d9108758-4a99-5098-9e53-f33d638c21c8

	/// Weighted by copies: a pair with 30 copies weighs more than a pair with 1.
	measure 'Avg Utilization (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN
			    CALCULATE (
			        DIVIDE ( SUM ( FACT_INVENTORY_SNAPSHOT[active_loans] ), SUM ( FACT_INVENTORY_SNAPSHOT[total_copies] ) ),
			        FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d )
			    )
		formatString: 0.0%
		displayFolder: 06 - Stock
		lineageTag: 41c5c264-8c3c-5740-a122-c228045fdbdb

	measure 'Out-of-Stock Rate % (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN
			    CALCULATE (
			        DIVIDE (
			            CALCULATE ( COUNTROWS ( FACT_INVENTORY_SNAPSHOT ), FACT_INVENTORY_SNAPSHOT[out_of_stock] = TRUE () ),
			            COUNTROWS ( FACT_INVENTORY_SNAPSHOT )
			        ),
			        FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d )
			    )
		formatString: 0.0%
		displayFolder: 06 - Stock
		lineageTag: 0abdeaa9-3f7a-5728-b90e-5076e21fb48b

	/// Weighted by copies.
	measure 'Avg Utilization (Month)' = DIVIDE ( SUM ( FACT_INVENTORY_SNAPSHOT[active_loans] ), SUM ( FACT_INVENTORY_SNAPSHOT[total_copies] ) )
		formatString: 0.0%
		displayFolder: 06 - Stock
		lineageTag: 4c281834-d79d-58f2-a48d-4b66f13924bd

	measure 'Unsatisfied Reservations (Month)' = SUM ( FACT_INVENTORY_SNAPSHOT[unsatisfied_reservations] )
		formatString: #,0
		displayFolder: 06 - Stock
		lineageTag: f7410c5f-57a7-5579-ac2c-71c2e13b59c4

	measure 'Critical Pairs (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN CALCULATE ( COUNTROWS ( FACT_INVENTORY_SNAPSHOT ), FACT_INVENTORY_SNAPSHOT[reallocation_priority] = "Critical", FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d ) )
		formatString: #,0
		displayFolder: 06 - Stock
		lineageTag: 611c66e7-47e6-5c5d-971e-f0682413e5a9

	measure 'Unsatisfied Demand (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN CALCULATE ( SUM ( FACT_INVENTORY_SNAPSHOT[unsatisfied_reservations] ), FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d ) )
		formatString: #,0
		displayFolder: 06 - Stock
		lineageTag: 7c424bf9-b5d2-5763-95f0-0836150694f9

	measure 'Idle Copies (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN CALCULATE ( SUM ( FACT_INVENTORY_SNAPSHOT[available_copies] ), FACT_INVENTORY_SNAPSHOT[reallocation_priority] = "Low", FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d ) )
		formatString: #,0
		displayFolder: 06 - Stock
		lineageTag: 7c16c404-d368-5f0b-8ab1-c716db8f6b71

	/// Idle copies that can move while keeping one copy on site.
	measure 'Movable Idle Copies (Last Month)' =
			VAR d = [_Last Snapshot Date]
			RETURN
			    CALCULATE (
			        SUMX ( FACT_INVENTORY_SNAPSHOT, MAX ( FACT_INVENTORY_SNAPSHOT[available_copies] - 1, 0 ) ),
			        FACT_INVENTORY_SNAPSHOT[reallocation_priority] = "Low",
			        FACT_INVENTORY_SNAPSHOT[available_copies] >= 2,
			        FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d )
			    )
		formatString: #,0
		displayFolder: 06 - Stock
		lineageTag: f85eb300-9833-5233-bbb3-941650675f48

	/// Share of last month's unmet demand coverable by moving idle stock, with no new purchase.
	measure 'Reallocation Coverage Rate %' = DIVIDE ( [Movable Idle Copies (Last Month)], [Unsatisfied Demand (Last Month)] )
		formatString: 0.0%
		displayFolder: 06 - Stock
		lineageTag: 9f2a8472-27f5-50c0-86e8-08e9b2e86314

	measure 'Current Reallocation Priority' =
			VAR d = [_Last Snapshot Date]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( FACT_INVENTORY_SNAPSHOT[reallocation_priority] ),
			        FILTER ( ALL ( DIM_DATE ), DIM_DATE[date_id] = d ),
			        ALL ( FACT_INVENTORY_SNAPSHOT[reallocation_priority] )
			    )
		displayFolder: 06 - Stock
		lineageTag: a122f8f9-ae94-5c9f-b9aa-43ed40cc4816

