table FACT_RESERVATION
	lineageTag: d1273b24-1694-5006-aed2-a3c6f6c6364b

	measure 'Total Reservations' = COUNTROWS ( FACT_RESERVATION )
		formatString: #,0
		displayFolder: 00 - Common
		lineageTag: aa313241-05fc-5313-bc3c-fefb766c4056

	measure 'Fulfilled Reservations' = CALCULATE ( [Total Reservations], FACT_RESERVATION[reservation_status] = "fulfilled" )
		formatString: #,0
		displayFolder: 00 - Common
		lineageTag: e26ed0a8-fab7-591b-a3f4-4a89345734ac

	measure 'Pending Reservations' = CALCULATE ( [Total Reservations], FACT_RESERVATION[reservation_status] = "pending" )
		formatString: #,0
		displayFolder: 00 - Common
		lineageTag: e4b8d28f-dbdd-52ad-9255-1fd76128b001

	measure 'Cancelled Reservations' = CALCULATE ( [Total Reservations], FACT_RESERVATION[reservation_status] = "cancelled" )
		formatString: #,0
		displayFolder: 00 - Common
		lineageTag: 37bac29c-bd13-5b76-a478-63ea04316812

	measure 'Reservation Fulfillment Rate %' = DIVIDE ( [Fulfilled Reservations], [Total Reservations] )
		formatString: 0.0%
		displayFolder: 05 - Catalogue
		lineageTag: 3e682ec1-0ab4-59c3-aaf5-b95a74bade34

	measure 'Reservation Cancel Rate %' = DIVIDE ( [Cancelled Reservations], [Total Reservations] )
		formatString: 0.0%
		displayFolder: 05 - Catalogue
		lineageTag: 31bb1126-6930-500c-8b39-6f9460520dc9

	measure 'Avg Reservation Wait (days)' = AVERAGE ( FACT_RESERVATION[wait_days] )
		formatString: #,0.0
		displayFolder: 05 - Catalogue
		lineageTag: c9424d66-2f75-541a-8059-b78d13349814

	measure 'Demand Pressure (Resv per Loan)' = DIVIDE ( [Total Reservations], [Total Loans] )
		formatString: #,0.00
		displayFolder: 05 - Catalogue
		lineageTag: 9bec7faf-4af9-5ae4-b03f-879f2622f11b

