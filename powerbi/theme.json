{
  "name": "Library Analytics",
  "dataColors": [
    "#1F5F8B",
    "#2A9D8F",
    "#E76F51",
    "#7B5EA7",
    "#E9C46A",
    "#4F7942",
    "#B5446E",
    "#6C7A89"
  ],
  "background": "#FFFFFF",
  "foreground": "#1D2B36",
  "tableAccent": "#1F5F8B",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#E76F51",
  "maximum": "#1F5F8B",
  "center": "#E9C46A",
  "minimum": "#F4F1EA",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F5F8B" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1D2B36" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1D2B36" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4A5A68" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DCE3E8" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1D2B36" } }, "fontSize": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F1EA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F1EA" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "card": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#1F5F8B" } }, "radius": 8 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F5F8B" } } }]
      }
    }
  }
}
